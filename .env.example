# Public (safe for the browser)
NEXT_PUBLIC_SITE_URL=https://cybarq.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
RESEND_API_KEY=
EMAIL_FROM="CyBarq <no-reply@cybarq.com>"
CONTACT_INBOX=info@cybarq.com
# 32+ random characters, used to hash IP addresses for rate limiting and contact submissions.
RATE_LIMIT_SALT=change-me

# Optional: secret for the scheduled publishing endpoint (/api/cron/publish)
CRON_SECRET=
